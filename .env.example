MONGODB_ROOT_USERNAME=academic_drive_admin
MONGODB_ROOT_PASSWORD=replace-with-a-local-mongodb-password
MONGODB_URI=mongodb://academic_drive_admin:replace-with-a-local-mongodb-password@localhost:27017/academic_drive?authSource=admin

GOOGLE_CLIENT_ID=replace-with-your-google-oauth-web-client-id
GOOGLE_CLIENT_SECRET=replace-with-your-google-oauth-web-client-secret

GOOGLE_ISSUER_URI=https://accounts.google.com
GOOGLE_API_BASE_URL=https://www.googleapis.com
GOOGLE_USERINFO_URL=https://www.googleapis.com/oauth2/v3/userinfo
GOOGLE_TOKEN_REVOCATION_URL=https://oauth2.googleapis.com/revoke
TOKEN_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
APP_FRONTEND_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
CSRF_COOKIE_DOMAIN=
